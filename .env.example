# Copy to .env and adjust. .env is gitignored.

# Matches the role and database created in the README; point elsewhere for managed Postgres.
DATABASE_URL=postgres://plants:plants@127.0.0.1:5432/plants

# API port; binds to 127.0.0.1 in dev, 0.0.0.0 in production.
PORT=3001
NODE_ENV=development

# Clerk (https://dashboard.clerk.com) — use test keys locally, live keys on Render.
CLERK_PUBLISHABLE_KEY=pk_test_your-key-here
CLERK_SECRET_KEY=sk_test_your-key-here

# Client reads the publishable key at build time (Vite).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your-key-here

# Photo uploads directory (local dev). On Render use /data/uploads with a persistent disk.
UPLOADS_DIR=

# Phase 6 (photo diagnosis).
GEMINI_API_KEY=your-key-here
VISION_MODEL=gemini-3.6-flash
