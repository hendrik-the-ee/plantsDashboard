# Copy to .env and adjust. .env is gitignored.

# Matches the role and database created in the README; point elsewhere for managed Postgres.
DATABASE_URL=postgres://plants:plants@127.0.0.1:5432/plants

# API port; the server always binds to 127.0.0.1.
PORT=3001

# Phase 5 (photo diagnosis) only.
GEMINI_API_KEY=your-key-here
VISION_MODEL=gemini-2.5-flash
